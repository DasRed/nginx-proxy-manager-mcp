# Nginx Proxy Manager admin API (port 81), with or without trailing /api
NPM_URL=http://nginx-proxy-manager:81

# Dedicated NPM user for the MCP server (no 2FA).
# For read-only mode give it "View Only" on all sections in NPM.
NPM_EMAIL=
NPM_PASSWORD=

# Request timeout against NPM in milliseconds
NPM_TIMEOUT_MS=30000

# HTTP listener
HOST=0.0.0.0
PORT=3000
MCP_PATH=/mcp

# Only expose read-only tools (default: true)
MCP_READ_ONLY=true

# Optional tool name filters, comma separated, "*" as wildcard
MCP_TOOLS_ALLOW=
MCP_TOOLS_DENY=

# Optional: require "Authorization: Bearer <token>" on the MCP endpoint
MCP_AUTH_TOKEN=
